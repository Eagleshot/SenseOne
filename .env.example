# Shared frontend and backend environment

FRONTEND_PORT=8080
BACKEND_PORT=3000

# Frontend
VITE_API_BASE_URL=/api/v1

# Backend
APP_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
APP_AUTH_EMAIL=admin@example.com
APP_AUTH_PASSWORD=change-me-to-a-long-random-secret
# Reject plain-HTTP user/browser routes. Set true in production (behind the
# Cloudflare tunnel / a TLS-terminating proxy); leave false for local HTTP dev.
# Device ingestion (/device/*) stays HTTP-allowed because it is HMAC-signed.
# This also flips the session cookie's Secure flag on.
APP_REQUIRE_HTTPS=false
OPENWEATHER_API_KEY=

# Proxy-header trust. uvicorn only honors X-Forwarded-Proto/-For (needed for
# HTTPS enforcement and per-IP login throttling) from these sources. Defaults to
# the pinned compose network subnet. NEVER set to "*" — that lets any client
# spoof the scheme/IP. Set to your real proxy/cloudflared CIDR in production.
APP_FORWARDED_ALLOW_IPS=172.28.0.0/16

# Stop accepting image uploads when free disk would drop below this many bytes
# (safety valve against a misbehaving device filling the disk). 0 disables.
APP_MIN_FREE_DISK_BYTES=524288000

CLOUDFLARE_TUNNEL_TOKEN=

# --- Database ---------------------------------------------------------------
# Control-plane data is a local SQLite file, created automatically at
# <APP_DATA_DIR>/control.db (the backend/data volume in docker). No setup needed.
# Set DATABASE_URL only to point the app at a different SQLAlchemy database:
# DATABASE_URL=sqlite:////absolute/path/to/control.db
